{
  "name": "tpu-deep-dive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/build-sources.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "check": "node scripts/check-content.mjs && node scripts/check-contrast.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:routing": "node scripts/e2e-routing.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.1",
    "playwright-core": "^1.64.1",
    "preact-render-to-string": "^6.8.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.7"
  }
}
